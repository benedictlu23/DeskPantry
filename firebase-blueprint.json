{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private coworker account record containing verified email, RBAC role, store debt balance, per-store debt map, owned/assigned store IDs, saved Gmail avatar URL, and admin-controlled Cash Assistance permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "department": { "type": "string", "maxLength": 120 },
        "tableRow": { "type": "string", "maxLength": 40 },
        "tableNumber": { "type": "string", "maxLength": 40 },
        "role": { "type": "string", "enum": ["guest", "member", "delivery_staff", "admin", "super_admin"] },
        "debtBalance": { "type": "number" },
        "storeDebtBalances": { "type": "object" },
        "cashAssistanceEnabled": { "type": "boolean" },
        "cashAssistanceLimit": { "type": "number" },
        "ownedStoreIds": { "type": "array" },
        "assignedStoreIds": { "type": "array" },
        "avatarInitials": { "type": "string", "maxLength": 6 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "department", "role", "debtBalance", "cashAssistanceEnabled", "cashAssistanceLimit", "avatarInitials", "totalSpent"]
    },
    "CoworkerProfile": {
      "title": "CoworkerProfile",
      "description": "Non-PII coworker display profile (name, department, desk location, avatar) readable by signed-in coworkers for chat and marketplace display.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "tableRow": { "type": "string", "maxLength": 40 },
        "tableNumber": { "type": "string", "maxLength": 40 },
        "avatarInitials": { "type": "string", "maxLength": 6 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "department", "avatarInitials"]
    },
    "PlatformConfig": {
      "title": "PlatformConfig",
      "description": "Platform-level subscription pricing, default cutoff days, and delivery commission rules configured by Super Admin in Developer Settings.",
      "type": "object",
      "properties": {
        "baseStoreMonthlyFee": { "type": "number" },
        "cashAssistanceMonthlyFee": { "type": "number" },
        "defaultDueDays": { "type": "array" },
        "defaultDeliveryFee": { "type": "number" },
        "deliveryCommissionRate": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["baseStoreMonthlyFee", "cashAssistanceMonthlyFee", "defaultDueDays", "defaultDeliveryFee", "deliveryCommissionRate"]
    },
    "StoreProfile": {
      "title": "StoreProfile",
      "description": "Multi-store profile containing store metadata, base subscription status, owner reference, delivery assignment, payment channels, and cutoff schedule.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "past_due", "suspended"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "suspended"] },
        "monthlyFee": { "type": "number" },
        "cashAssistanceActive": { "type": "boolean" },
        "assignedDeliveryStaffIds": { "type": "array" },
        "storeAnnouncement": { "type": "string", "maxLength": 500 },
        "deliveryEnabled": { "type": "boolean" },
        "deliveryFee": { "type": "number" },
        "walletAccountName": { "type": "string", "maxLength": 120 },
        "walletAccountNumber": { "type": "string", "maxLength": 60 },
        "dueDays": { "type": "array" },
        "categories": { "type": "array" },
        "paymentMethods": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "ownerId", "ownerName", "status", "subscriptionStatus", "monthlyFee", "cashAssistanceActive", "assignedDeliveryStaffIds", "storeAnnouncement", "deliveryEnabled", "deliveryFee", "walletAccountName", "walletAccountNumber", "dueDays", "categories", "paymentMethods", "createdAt"]
    },
    "StoreCashAssistanceConfig": {
      "title": "StoreCashAssistanceConfig",
      "description": "Confidential per-store Cash Assistance add-on subscription configuration, strictly hidden from regular coworkers and only visible to the Store Owner when visibleToOwner is enabled by Admin/SuperAdmin.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "storeOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["locked", "pending_approval", "active", "suspended"] },
        "visibleToOwner": { "type": "boolean" },
        "monthlyFee": { "type": "number" },
        "monthlyInterestRate": { "type": "number" },
        "dueDays": { "type": "array" },
        "availableTerms": { "type": "array" },
        "requestedAt": { "type": "string", "maxLength": 60 },
        "requestNote": { "type": "string", "maxLength": 400 },
        "approvedBy": { "type": "string", "maxLength": 120 },
        "approvedAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "storeName", "storeOwnerId", "status", "visibleToOwner", "monthlyFee", "monthlyInterestRate", "dueDays", "availableTerms"]
    },
    "StoreApplication": {
      "title": "StoreApplication",
