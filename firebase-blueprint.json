      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gcashNumber": { "type": "string", "maxLength": 60 },
        "mayaNumber": { "type": "string", "maxLength": 60 },
        "paymentNotes": { "type": "string", "maxLength": 300 },
        "defaultPickupNote": { "type": "string", "maxLength": 200 },
        "defaultReminderTemplate": { "type": "string", "maxLength": 300 },
        "defaultAllowCash": { "type": "boolean" },
        "defaultAllowDebt": { "type": "boolean" },
        "notifyOnNewSale": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "defaultReminderTemplate", "defaultAllowCash", "defaultAllowDebt"]
    },
    "EWalletPost": {
      "title": "EWalletPost",
      "description": "Peer-to-peer e-wallet cash exchange post among signed-in coworkers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["sell", "buy"] },
        "walletProvider": { "type": "string", "maxLength": 60 },
        "totalAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "accountNumber": { "type": "string", "maxLength": 80 },
        "accountName": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 400 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorDepartment": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["Open", "Partially Filled", "Completed"] },
        "completedAtMs": { "type": "number" },
        "fills": { "type": "array" },
        "comments": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "walletProvider", "totalAmount", "remainingAmount", "accountNumber", "accountName", "authorId", "authorName", "authorDepartment", "createdAt", "status", "fills", "comments"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Department chat thread or direct message metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 140 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["ai", "channel", "dm"] },
        "participantIds": { "type": "array" },
        "unreadCount": { "type": "number" },
        "unreadBy": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "subtitle", "type", "participantIds", "unreadCount"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a chat thread subcollection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderRole": { "type": "string", "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "timestamp": { "type": "string", "maxLength": 60 },
        "createdAtMs": { "type": "number" }
      },
      "required": ["id", "senderId", "senderName", "senderRole", "text", "timestamp"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "User, store owner, or admin notification entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 140 },
        "body": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 60 },
        "type": { "type": "string", "enum": ["reminder", "payment", "marketplace", "chat", "delivery", "community", "ewallet", "store", "cash_assistance"] },
        "read": { "type": "boolean" },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "createdAtMs": { "type": "number" }
      },
      "required": ["id", "title", "body", "timestamp", "type", "read", "targetUserId"]
    },
    "InternalApp": {
      "title": "InternalApp",
      "description": "Internal company app directory entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "platform": { "type": "string", "maxLength": 80 },
        "version": { "type": "string", "maxLength": 40 },
        "actionType": { "type": "string", "enum": ["open", "install"] },
        "installed": { "type": "boolean" },
        "image": { "type": "string", "maxLength": 400000 },
        "url": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "tagline", "description", "platform", "version", "actionType", "installed", "image", "url"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private coworker account records (PII, role, storeDebtBalances, ownedStoreIds, assignedStoreIds, Cash Assistance permissions)."
    },
    "/coworkerProfiles/{userId}": {
      "schema": { "$ref": "#/entities/CoworkerProfile" },
      "description": "Non-PII coworker display profiles (name, department, avatar) for authenticated display."
    },
    "/config/platform": {
      "schema": { "$ref": "#/entities/PlatformConfig" },
      "description": "Platform subscription pricing, default cutoffs, and delivery commission configuration."
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Public multi-store profiles, announcements, fulfillment options, and payment channels."
    },
    "/storeCashAssistance/{storeId}": {
      "schema": { "$ref": "#/entities/StoreCashAssistanceConfig" },
      "description": "Confidential per-store Cash Assistance add-on configuration hidden from non-owners and locked until Admin/SuperAdmin reveals and approves."
    },
    "/storeApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/StoreApplication" },
      "description": "Coworker applications to open independent stores."
    },
    "/catalogTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/CatalogTemplate" },
      "description": "Shared product catalog templates adoptable across stores."
    },
    "/storeCustomerCredits/{creditId}": {
      "schema": { "$ref": "#/entities/StoreCustomerCredit" },
      "description": "Per-store isolated customer store credit ledgers."
    },
    "/storeItems/{itemId}": {
      "schema": { "$ref": "#/entities/StoreItem" },
      "description": "Store-scoped inventory catalog items and cost history."
    },
    "/stockAdjustments/{adjustmentId}": {
      "schema": { "$ref": "#/entities/StockAdjustmentLog" },
      "description": "Immutable store-scoped stock adjustment and restock history logs."
    },
    "/config/store": {
      "schema": { "$ref": "#/entities/StoreConfig" },
      "description": "Flagship storefront configuration, payment methods, and due days."
    },
    "/config/cashAssistance": {
      "schema": { "$ref": "#/entities/CashAssistanceSettings" },
      "description": "Confidential Cash Assistance settings readable only by Admin, approved coworkers, or authorized Store Owners."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/StoreOrder" },
      "description": "Store-scoped and marketplace orders."
    },
    "/paymentProofs/{proofId}": {
      "schema": { "$ref": "#/entities/PaymentProof" },
      "description": "Digital payment receipt proofs submitted by coworkers."
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/LoanRecord" },
      "description": "Confidential Cash Assistance records."
    },
    "/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/SuggestionItem" },
      "description": "Community snack suggestions and coworker votes."
    },
    "/marketplaceListings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "Coworker for-sale food/product listings."
    },
    "/sellerConfigs/{userId}": {
      "schema": { "$ref": "#/entities/SellerConfig" },
      "description": "Per-seller payout, reminder template, and marketplace preferences."
    },
    "/ewalletPosts/{postId}": {
      "schema": { "$ref": "#/entities/EWalletPost" },
      "description": "Department peer-to-peer e-wallet buy/sell posts."
    },
    "/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Chat channels, AI thread, and direct message threads."
    },
    "/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a chat thread."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Targeted user, store owner, and admin notifications."
    },
    "/internalApps/{appId}": {
      "schema": { "$ref": "#/entities/InternalApp" },
      "description": "Department companion apps directory."
    }
  }
}
