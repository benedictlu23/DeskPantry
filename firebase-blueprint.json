        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedBy": { "type": "string", "maxLength": 120 },
        "reviewedAt": { "type": "string", "maxLength": 60 },
        "provisionedStoreId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "applicantId", "applicantName", "applicantDepartment", "storeName", "description", "paymentChannels", "quotedBaseFee", "status", "createdAt"]
    },
    "CatalogTemplate": {
      "title": "CatalogTemplate",
      "description": "Shared product template (e.g., Nova Multigrain Chips) adoptable by multiple independent stores with their own pricing, cost, and stock.",
      "type": "object",
