rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'benedictlu23@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        )
      );
    }

    function isDeliveryStaff() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery_staff'
      );
    }

    function isCashAssistanceAllowed() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cashAssistanceEnabled == true
      );
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'id', 'name', 'email', 'department', 'role',
          'debtBalance', 'cashAssistanceEnabled', 'cashAssistanceLimit',
          'avatarInitials', 'totalSpent'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'email', 'department', 'tableRow', 'tableNumber', 'role',
          'debtBalance', 'storeDebtBalances', 'cashAssistanceEnabled', 'cashAssistanceLimit',
          'ownedStoreIds', 'assignedStoreIds',
          'avatarInitials', 'avatarUrl', 'totalSpent',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.department is string && data.department.size() <= 120 &&
        (!('tableRow' in data) || (data.tableRow is string && data.tableRow.size() <= 40)) &&
        (!('tableNumber' in data) || (data.tableNumber is string && data.tableNumber.size() <= 40)) &&
        data.role in ['guest', 'member', 'delivery_staff', 'admin', 'super_admin'] &&
        data.debtBalance is number && data.debtBalance >= 0 &&
        (!('storeDebtBalances' in data) || (data.storeDebtBalances is map && data.storeDebtBalances.size() <= 50)) &&
        data.cashAssistanceEnabled is bool &&
        data.cashAssistanceLimit is number && data.cashAssistanceLimit >= 0 &&
        (!('ownedStoreIds' in data) || (data.ownedStoreIds is list && data.ownedStoreIds.size() <= 20 && (data.ownedStoreIds.size() == 0 || data.ownedStoreIds[0] is string))) &&
        (!('assignedStoreIds' in data) || (data.assignedStoreIds is list && data.assignedStoreIds.size() <= 30 && (data.assignedStoreIds.size() == 0 || data.assignedStoreIds[0] is string))) &&
        data.avatarInitials is string && data.avatarInitials.size() <= 6 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
        data.totalSpent is number && data.totalSpent >= 0 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidCoworkerProfile(data) {
      return data.keys().hasAll(['id', 'name', 'department', 'avatarInitials']) &&
        data.keys().hasOnly(['id', 'name', 'department', 'tableRow', 'tableNumber', 'avatarInitials', 'avatarUrl', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.department is string && data.department.size() <= 120 &&
        (!('tableRow' in data) || (data.tableRow is string && data.tableRow.size() <= 40)) &&
        (!('tableNumber' in data) || (data.tableNumber is string && data.tableNumber.size() <= 40)) &&
        data.avatarInitials is string && data.avatarInitials.size() <= 6 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll([
          'baseStoreMonthlyFee', 'cashAssistanceMonthlyFee',
          'defaultDueDays', 'defaultDeliveryFee', 'deliveryCommissionRate'
        ]) &&
        data.keys().hasOnly([
          'baseStoreMonthlyFee', 'cashAssistanceMonthlyFee',
          'defaultDueDays', 'defaultDeliveryFee', 'deliveryCommissionRate', 'updatedAt'
        ]) &&
        data.baseStoreMonthlyFee is number && data.baseStoreMonthlyFee >= 0 &&
        data.cashAssistanceMonthlyFee is number && data.cashAssistanceMonthlyFee >= 0 &&
        data.defaultDueDays is list && data.defaultDueDays.size() == 2 &&
        data.defaultDeliveryFee is number && data.defaultDeliveryFee >= 0 &&
        data.deliveryCommissionRate is number && data.deliveryCommissionRate >= 0 && data.deliveryCommissionRate <= 100 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidStoreProfile(data) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'ownerId', 'ownerName',
          'status', 'subscriptionStatus', 'monthlyFee', 'cashAssistanceActive',
          'assignedDeliveryStaffIds', 'storeAnnouncement', 'deliveryEnabled',
          'deliveryFee', 'walletAccountName', 'walletAccountNumber',
          'dueDays', 'categories', 'paymentMethods', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'description', 'ownerId', 'ownerName',
          'status', 'subscriptionStatus', 'monthlyFee', 'cashAssistanceActive',
          'assignedDeliveryStaffIds', 'storeAnnouncement', 'deliveryEnabled',
          'deliveryFee', 'walletAccountName', 'walletAccountNumber',
          'dueDays', 'categories', 'paymentMethods', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        isValidId(data.ownerId) &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120 &&
        data.status in ['active', 'past_due', 'suspended'] &&
        data.subscriptionStatus in ['active', 'past_due', 'suspended'] &&
        data.monthlyFee is number && data.monthlyFee >= 0 &&
        data.cashAssistanceActive is bool &&
        data.assignedDeliveryStaffIds is list && data.assignedDeliveryStaffIds.size() <= 30 &&
        (data.assignedDeliveryStaffIds.size() == 0 || data.assignedDeliveryStaffIds[0] is string) &&
        data.storeAnnouncement is string && data.storeAnnouncement.size() <= 500 &&
        data.deliveryEnabled is bool &&
        data.deliveryFee is number && data.deliveryFee >= 0 &&
        data.walletAccountName is string && data.walletAccountName.size() <= 120 &&
        data.walletAccountNumber is string && data.walletAccountNumber.size() <= 60 &&
        data.dueDays is list && data.dueDays.size() == 2 &&
        data.categories is list && data.categories.size() <= 30 &&
        data.paymentMethods is list && data.paymentMethods.size() <= 20 &&
        data.createdAt is string && data.createdAt.size() <= 60 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidStoreCashAssistance(data) {
      return data.keys().hasAll([
          'storeId', 'storeName', 'storeOwnerId', 'status', 'visibleToOwner',
          'monthlyFee', 'monthlyInterestRate', 'dueDays', 'availableTerms'
        ]) &&
        data.keys().hasOnly([
          'storeId', 'storeName', 'storeOwnerId', 'status', 'visibleToOwner',
          'monthlyFee', 'monthlyInterestRate', 'dueDays', 'availableTerms',
          'requestedAt', 'requestNote', 'approvedBy', 'approvedAt', 'updatedAt'
        ]) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120 &&
        isValidId(data.storeOwnerId) &&
        data.status in ['locked', 'pending_approval', 'active', 'suspended'] &&
        data.visibleToOwner is bool &&
        data.monthlyFee is number && data.monthlyFee >= 0 &&
        data.monthlyInterestRate is number && data.monthlyInterestRate >= 0 && data.monthlyInterestRate <= 50 &&
        data.dueDays is list && data.dueDays.size() == 2 &&
        data.availableTerms is list && data.availableTerms.size() >= 1 && data.availableTerms.size() <= 24 &&
        (!('requestedAt' in data) || (data.requestedAt is string && data.requestedAt.size() <= 60)) &&
        (!('requestNote' in data) || (data.requestNote is string && data.requestNote.size() <= 400)) &&
        (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 120)) &&
        (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 60)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidStoreApplication(data) {
      return data.keys().hasAll([
          'id', 'applicantId', 'applicantName', 'applicantDepartment',
          'storeName', 'description', 'paymentChannels', 'quotedBaseFee',
          'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'applicantId', 'applicantName', 'applicantDepartment',
          'storeName', 'description', 'paymentChannels', 'quotedBaseFee',
          'status', 'reviewedBy', 'reviewedAt', 'provisionedStoreId',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.applicantId) &&
        data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 120 &&
        data.applicantDepartment is string && data.applicantDepartment.size() <= 120 &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        data.paymentChannels is string && data.paymentChannels.size() <= 300 &&
        data.quotedBaseFee is number && data.quotedBaseFee >= 0 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 60)) &&
        (!('provisionedStoreId' in data) || (data.provisionedStoreId is string && data.provisionedStoreId.size() <= 128)) &&
        data.createdAt is string && data.createdAt.size() <= 60 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidCatalogTemplate(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'description', 'suggestedPrice',
          'createdByStoreId', 'createdByStoreName', 'createdByUserId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'description', 'suggestedPrice',
          'image', 'barcode', 'createdByStoreId', 'createdByStoreName',
          'createdByUserId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.description is string && data.description.size() <= 600 &&
        data.suggestedPrice is number && data.suggestedPrice >= 0 &&
        (!('image' in data) || (data.image is string && data.image.size() <= 400000)) &&
        (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64)) &&
        isValidId(data.createdByStoreId) &&
        data.createdByStoreName is string && data.createdByStoreName.size() <= 120 &&
        isValidId(data.createdByUserId) &&
        data.createdAt is string && data.createdAt.size() <= 60 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidStoreCustomerCredit(data) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeName', 'storeOwnerId', 'userId', 'userName',
          'balance', 'totalCharged', 'totalPaid', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeOwnerId', 'userId', 'userName',
          'balance', 'totalCharged', 'totalPaid', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120 &&
        isValidId(data.storeOwnerId) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.balance is number && data.balance >= 0 &&
        data.totalCharged is number && data.totalCharged >= 0 &&
        data.totalPaid is number && data.totalPaid >= 0 &&
        data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidStoreItem(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'description',
          'price', 'costPrice', 'costHistory', 'stock', 'soldCount'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeOwnerId', 'templateId',
          'name', 'category', 'description',
          'price', 'costPrice', 'costHistory', 'stock', 'soldCount',
          'image', 'barcode', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        (!('storeId' in data) || isValidId(data.storeId)) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 120)) &&
        (!('storeOwnerId' in data) || isValidId(data.storeOwnerId)) &&
        (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 128)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.description is string && data.description.size() <= 600 &&
        data.price is number && data.price >= 0 &&
        data.costPrice is number && data.costPrice >= 0 &&
        data.costHistory is list && data.costHistory.size() <= 100 &&
        data.stock is number && data.stock >= 0 &&
        data.soldCount is number && data.soldCount >= 0 &&
        (!('image' in data) || (data.image is string && data.image.size() <= 400000)) &&
        (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidStockAdjustment(data) {
      return data.keys().hasAll([
          'id', 'itemId', 'itemName', 'itemCategory', 'adjustmentType',
          'reason', 'previousStock', 'delta', 'newStock', 'unitCostAtTime',
          'adjustedById', 'adjustedByName', 'createdAt', 'createdAtMs'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeOwnerId',
          'itemId', 'itemName', 'itemCategory', 'barcode',
          'adjustmentType', 'reason', 'note', 'previousStock', 'delta',
          'newStock', 'unitCostAtTime', 'adjustedById', 'adjustedByName',
          'createdAt', 'createdAtMs'
        ]) &&
        isValidId(data.id) &&
        (!('storeId' in data) || isValidId(data.storeId)) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 120)) &&
        (!('storeOwnerId' in data) || isValidId(data.storeOwnerId)) &&
        isValidId(data.itemId) &&
        data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 140 &&
        data.itemCategory is string && data.itemCategory.size() >= 1 && data.itemCategory.size() <= 80 &&
        (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64)) &&
        data.adjustmentType in ['add', 'deduct', 'recount', 'restock'] &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 120 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 400)) &&
        data.previousStock is number && data.previousStock >= 0 &&
        data.delta is number &&
        data.newStock is number && data.newStock >= 0 &&
        data.newStock == data.previousStock + data.delta &&
        data.unitCostAtTime is number && data.unitCostAtTime >= 0 &&
        isValidId(data.adjustedById) &&
        data.adjustedByName is string && data.adjustedByName.size() >= 1 && data.adjustedByName.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 80 &&
        data.createdAtMs is number && data.createdAtMs > 0;
    }

    function isValidStoreConfig(data) {
      return data.keys().hasAll([
          'storeAnnouncement', 'deliveryEnabled', 'deliveryFee',
          'walletAccountName', 'walletAccountNumber',
          'categories', 'paymentMethods', 'dueDays'
        ]) &&
        data.keys().hasOnly([
          'storeAnnouncement', 'deliveryEnabled', 'deliveryFee',
          'walletAccountName', 'walletAccountNumber',
          'categories', 'paymentMethods', 'dueDays',
          'ownerCommissionEarned', 'updatedAt'
        ]) &&
        data.storeAnnouncement is string && data.storeAnnouncement.size() <= 500 &&
        data.deliveryEnabled is bool &&
        data.deliveryFee is number && data.deliveryFee >= 0 &&
        data.walletAccountName is string && data.walletAccountName.size() <= 120 &&
        data.walletAccountNumber is string && data.walletAccountNumber.size() <= 60 &&
        data.categories is list && data.categories.size() <= 30 &&
        data.paymentMethods is list && data.paymentMethods.size() <= 20 &&
        data.dueDays is list && data.dueDays.size() == 2 &&
        (!('ownerCommissionEarned' in data) || (data.ownerCommissionEarned is number && data.ownerCommissionEarned >= 0)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidCashAssistanceConfig(data) {
      return data.keys().hasAll(['globalEnabled', 'monthlyInterestRate', 'dueDays', 'availableTerms']) &&
        data.keys().hasOnly(['globalEnabled', 'monthlyInterestRate', 'dueDays', 'availableTerms', 'updatedAt']) &&
        data.globalEnabled is bool &&
        data.monthlyInterestRate is number && data.monthlyInterestRate >= 0 && data.monthlyInterestRate <= 50 &&
        data.dueDays is list && data.dueDays.size() == 2 &&
        data.availableTerms is list && data.availableTerms.size() >= 1 && data.availableTerms.size() <= 24 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'items', 'totalAmount',
          'fulfillment', 'paymentMethod', 'status', 'createdAt',
          'orderDateIso', 'source', 'logs'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeOwnerId', 'assignedDeliveryStaffIds',
          'userId', 'userName', 'buyerDepartment', 'buyerTableRow', 'buyerTableNumber',
          'items', 'subtotal', 'totalAmount',
          'deliveryFee', 'deliveryCommission', 'fulfillment', 'deliveryNote',
          'paymentMethod', 'paymentType', 'status', 'deliveryStatus', 'assignedRunnerId',
          'assignedRunner', 'cashCollected', 'createdAt', 'orderDateIso',
          'deliveredAt', 'dueDateLabel', 'source', 'commissionEarned',
          'sellerId', 'sellerName', 'debtSettled', 'debtPaidAmount', 'settledAt',
          'logs', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        (!('storeId' in data) || isValidId(data.storeId)) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 120)) &&
        (!('storeOwnerId' in data) || isValidId(data.storeOwnerId)) &&
        (!('assignedDeliveryStaffIds' in data) || (data.assignedDeliveryStaffIds is list && data.assignedDeliveryStaffIds.size() <= 30 && (data.assignedDeliveryStaffIds.size() == 0 || data.assignedDeliveryStaffIds[0] is string))) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        (!('buyerDepartment' in data) || (data.buyerDepartment is string && data.buyerDepartment.size() <= 120)) &&
        (!('buyerTableRow' in data) || (data.buyerTableRow is string && data.buyerTableRow.size() <= 40)) &&
        (!('buyerTableNumber' in data) || (data.buyerTableNumber is string && data.buyerTableNumber.size() <= 40)) &&
        data.items is list && data.items.size() <= 50 &&
        (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0)) &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.fulfillment in ['Pickup', 'Delivery'] &&
        data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 80 &&
        (!('paymentType' in data) || data.paymentType in ['cash', 'credit', 'ewallet']) &&
        data.status in ['Confirmed', 'Pending Payment Proof', 'Completed', 'Pending Admin Review', 'Pending Seller Confirmation', 'Rejected'] &&
        data.createdAt is string && data.createdAt.size() <= 80 &&
        data.orderDateIso is string && data.orderDateIso.size() <= 40 &&
        data.source in ['store', 'marketplace'] &&
        data.logs is list && data.logs.size() <= 50 &&
        (!('deliveryFee' in data) || data.deliveryFee is number) &&
        (!('deliveryCommission' in data) || data.deliveryCommission is number) &&
        (!('deliveryNote' in data) || (data.deliveryNote is string && data.deliveryNote.size() <= 300)) &&
        (!('deliveryStatus' in data) || data.deliveryStatus in ['Pending Dispatch', 'Out for Delivery', 'Delivered', 'Pending Admin Approval', 'Pending Seller Approval', 'Cancelled']) &&
        (!('assignedRunnerId' in data) || (data.assignedRunnerId is string && data.assignedRunnerId.size() <= 128)) &&
        (!('assignedRunner' in data) || (data.assignedRunner is string && data.assignedRunner.size() <= 120)) &&
        (!('cashCollected' in data) || data.cashCollected is bool) &&
        (!('deliveredAt' in data) || (data.deliveredAt is string && data.deliveredAt.size() <= 80)) &&
        (!('dueDateLabel' in data) || (data.dueDateLabel is string && data.dueDateLabel.size() <= 80)) &&
        (!('commissionEarned' in data) || data.commissionEarned is number) &&
        (!('sellerId' in data) || isValidId(data.sellerId)) &&
        (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 120)) &&
        (!('debtSettled' in data) || data.debtSettled is bool) &&
        (!('debtPaidAmount' in data) || (data.debtPaidAmount is number && data.debtPaidAmount >= 0)) &&
        (!('settledAt' in data) || (data.settledAt is string && data.settledAt.size() <= 80)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidPaymentProof(data) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'amount', 'channel',
          'referenceNo', 'purpose', 'imageDataUrl', 'submittedAt', 'status'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeOwnerId',
          'userId', 'userName', 'amount', 'channel',
          'referenceNo', 'purpose', 'imageDataUrl', 'submittedAt', 'status',
          'reviewedBy', 'reviewedAt', 'orderId', 'loanId',
          'sellerId', 'sellerName', 'orderIds', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        (!('storeId' in data) || isValidId(data.storeId)) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 120)) &&
        (!('storeOwnerId' in data) || isValidId(data.storeOwnerId)) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.amount is number && data.amount > 0 &&
        data.channel is string && data.channel.size() >= 1 && data.channel.size() <= 60 &&
        data.referenceNo is string && data.referenceNo.size() >= 1 && data.referenceNo.size() <= 100 &&
        data.purpose in ['Store Debt Settlement', 'Order Payment', 'Cash Assistance Repayment', 'Community Seller Settlement'] &&
        data.imageDataUrl is string && data.imageDataUrl.size() <= 400000 &&
        data.submittedAt is string && data.submittedAt.size() <= 80 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 80)) &&
        (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
        (!('loanId' in data) || (data.loanId is string && data.loanId.size() <= 128)) &&
        (!('sellerId' in data) || isValidId(data.sellerId)) &&
        (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 120)) &&
        (!('orderIds' in data) || (data.orderIds is list && data.orderIds.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidLoan(data) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'principal', 'interestRate',
          'months', 'totalPayable', 'remainingBalance', 'status',
          'createdAt', 'nextDueDate', 'repayments', 'installments'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'storeOwnerId',
          'userId', 'userName', 'principal', 'interestRate',
          'months', 'totalPayable', 'remainingBalance', 'status',
          'createdAt', 'nextDueDate', 'repayments', 'installments', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        (!('storeId' in data) || isValidId(data.storeId)) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 120)) &&
        (!('storeOwnerId' in data) || isValidId(data.storeOwnerId)) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.principal is number && data.principal >= 100 &&
        data.interestRate is number && data.interestRate >= 0 &&
        data.months is number && data.months >= 1 && data.months <= 36 &&
        data.totalPayable is number && data.totalPayable >= data.principal &&
        data.remainingBalance is number && data.remainingBalance >= 0 &&
        data.status in ['Active', 'Settled', 'Pending Approval'] &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.nextDueDate is string && data.nextDueDate.size() <= 40 &&
        data.repayments is list && data.repayments.size() <= 100 &&
        data.installments is list && data.installments.size() <= 48 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidSuggestion(data) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'reason', 'requestedById',
          'requestedByName', 'createdAt', 'voterIds', 'voterNames', 'status'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'category', 'reason', 'requestedById',
          'requestedByName', 'createdAt', 'voterIds', 'voterNames',
          'downvoterIds', 'downvoterNames', 'status',
          'addedToStoreAt', 'comments', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.reason is string && data.reason.size() <= 400 &&
        isValidId(data.requestedById) &&
        data.requestedByName is string && data.requestedByName.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 60 &&
        data.voterIds is list && data.voterIds.size() <= 200 &&
        data.voterNames is list && data.voterNames.size() <= 200 &&
        (!('downvoterIds' in data) || (data.downvoterIds is list && data.downvoterIds.size() <= 200)) &&
        (!('downvoterNames' in data) || (data.downvoterNames is list && data.downvoterNames.size() <= 200)) &&
        data.status in ['Open for Votes', 'Reviewing', 'Added to Pantry'] &&
        (!('addedToStoreAt' in data) || (data.addedToStoreAt is string && data.addedToStoreAt.size() <= 80)) &&
        (!('comments' in data) || (data.comments is list && data.comments.size() <= 200)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidMarketplaceListing(data) {
      return data.keys().hasAll([
          'id', 'sellerId', 'sellerName', 'sellerDepartment', 'title',
          'description', 'price', 'stock', 'soldCount', 'commissionType',
          'commissionValue', 'approvalStatus', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'sellerId', 'sellerName', 'sellerDepartment', 'title',
          'description', 'price', 'stock', 'soldCount', 'commissionType',
          'commissionValue', 'approvalStatus', 'createdAt', 'image',
          'paused', 'allowCash', 'allowDebt', 'pickupNote', 'paymentDetails', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.sellerId) &&
        data.sellerName is string && data.sellerName.size() <= 120 &&
        data.sellerDepartment is string && data.sellerDepartment.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.description is string && data.description.size() <= 600 &&
        data.price is number && data.price >= 0 &&
        data.stock is number && data.stock >= 0 &&
        data.soldCount is number && data.soldCount >= 0 &&
        data.commissionType in ['percentage', 'fixed'] &&
        data.commissionValue is number && data.commissionValue >= 0 &&
        data.approvalStatus in ['pending', 'approved', 'rejected'] &&
        data.createdAt is string && data.createdAt.size() <= 60 &&
        (!('image' in data) || (data.image is string && data.image.size() <= 400000)) &&
        (!('paused' in data) || data.paused is bool) &&
        (!('allowCash' in data) || data.allowCash is bool) &&
        (!('allowDebt' in data) || data.allowDebt is bool) &&
        (!('pickupNote' in data) || (data.pickupNote is string && data.pickupNote.size() <= 200)) &&
        (!('paymentDetails' in data) || (data.paymentDetails is string && data.paymentDetails.size() <= 200)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidSellerConfig(data) {
      return data.keys().hasAll([
          'userId', 'defaultReminderTemplate', 'defaultAllowCash', 'defaultAllowDebt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'gcashNumber', 'mayaNumber', 'paymentNotes',
          'defaultPickupNote', 'defaultReminderTemplate', 'defaultAllowCash',
          'defaultAllowDebt', 'notifyOnNewSale', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.defaultReminderTemplate is string && data.defaultReminderTemplate.size() <= 300 &&
        data.defaultAllowCash is bool &&
        data.defaultAllowDebt is bool &&
        (!('gcashNumber' in data) || (data.gcashNumber is string && data.gcashNumber.size() <= 60)) &&
        (!('mayaNumber' in data) || (data.mayaNumber is string && data.mayaNumber.size() <= 60)) &&
        (!('paymentNotes' in data) || (data.paymentNotes is string && data.paymentNotes.size() <= 300)) &&
        (!('defaultPickupNote' in data) || (data.defaultPickupNote is string && data.defaultPickupNote.size() <= 200)) &&
        (!('notifyOnNewSale' in data) || data.notifyOnNewSale is bool) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidEWalletPost(data) {
      return data.keys().hasAll([
          'id', 'type', 'walletProvider', 'totalAmount', 'remainingAmount',
          'accountNumber', 'accountName', 'authorId', 'authorName',
          'authorDepartment', 'createdAt', 'status', 'fills', 'comments'
        ]) &&
        data.keys().hasOnly([
          'id', 'type', 'walletProvider', 'totalAmount', 'remainingAmount',
          'accountNumber', 'accountName', 'notes', 'authorId', 'authorName',
          'authorDepartment', 'createdAt', 'status', 'completedAtMs',
          'fills', 'comments', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.type in ['sell', 'buy'] &&
        data.walletProvider is string && data.walletProvider.size() <= 60 &&
        data.totalAmount is number && data.totalAmount > 0 &&
        data.remainingAmount is number && data.remainingAmount >= 0 &&
        data.accountNumber is string && data.accountNumber.size() <= 80 &&
        data.accountName is string && data.accountName.size() <= 120 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() <= 120 &&
        data.authorDepartment is string && data.authorDepartment.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 60 &&
        data.status in ['Open', 'Partially Filled', 'Completed'] &&
        (!('completedAtMs' in data) || (data.completedAtMs is number && data.completedAtMs > 0)) &&
        data.fills is list && data.fills.size() <= 100 &&
        data.comments is list && data.comments.size() <= 200 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidChatThread(data) {
      return data.keys().hasAll(['id', 'title', 'subtitle', 'type', 'participantIds', 'unreadCount']) &&
        data.keys().hasOnly(['id', 'title', 'subtitle', 'type', 'participantIds', 'unreadCount', 'unreadBy', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.subtitle is string && data.subtitle.size() <= 200 &&
        data.type in ['ai', 'channel', 'dm'] &&
        data.participantIds is list && data.participantIds.size() <= 50 &&
        data.unreadCount is number && data.unreadCount >= 0 &&
        (!('unreadBy' in data) || (data.unreadBy is map && data.unreadBy.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp']) &&
        data.keys().hasOnly(['id', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp', 'createdAtMs']) &&
        isValidId(data.id) &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.senderRole is string && data.senderRole.size() >= 1 && data.senderRole.size() <= 40 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 4000 &&
        data.timestamp is string && data.timestamp.size() <= 60 &&
        (!('createdAtMs' in data) || data.createdAtMs is number);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'body', 'timestamp', 'type', 'read', 'targetUserId']) &&
        data.keys().hasOnly(['id', 'title', 'body', 'timestamp', 'type', 'read', 'targetUserId', 'createdAtMs']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
        data.timestamp is string && data.timestamp.size() <= 60 &&
        data.type in ['reminder', 'payment', 'marketplace', 'chat', 'delivery', 'community', 'ewallet', 'store', 'cash_assistance'] &&
        data.read is bool &&
        data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
        (!('createdAtMs' in data) || data.createdAtMs is number);
    }

    function isValidInternalApp(data) {
      return data.keys().hasAll(['id', 'name', 'tagline', 'description', 'platform', 'version', 'actionType', 'installed', 'image', 'url']) &&
        data.keys().hasOnly(['id', 'name', 'tagline', 'description', 'platform', 'version', 'actionType', 'installed', 'image', 'url']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.tagline is string && data.tagline.size() <= 200 &&
        data.description is string && data.description.size() <= 500 &&
        data.platform is string && data.platform.size() <= 80 &&
        data.version is string && data.version.size() <= 40 &&
        data.actionType in ['open', 'install'] &&
        data.installed is bool &&
        data.image is string && data.image.size() <= 400000 &&
        data.url is string && data.url.size() <= 500 &&
        (data.url == '#' || data.url == '' || data.url.matches('^https?://.*'));
    }

    // Connection test document for startup validation
    match /test/connection {
      allow get: if true;
    }

    // Private User Accounts (PII & RBAC)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserAccount(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().id == request.auth.uid &&
          incoming().debtBalance == 0 &&
          incoming().totalSpent == 0 &&
          (!('ownedStoreIds' in incoming()) || incoming().ownedStoreIds.size() == 0) &&
          (!('assignedStoreIds' in incoming()) || incoming().assignedStoreIds.size() == 0) &&
          (!('storeDebtBalances' in incoming()) || incoming().storeDebtBalances.size() == 0) &&
          (
            (isBootstrappedSuperAdmin() && incoming().role == 'super_admin' && incoming().cashAssistanceEnabled == true) ||
            (!isBootstrappedSuperAdmin() && incoming().role == 'member' && incoming().cashAssistanceEnabled == false && incoming().cashAssistanceLimit == 0)
          )
        )
      );

      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserAccount(incoming()) && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          incoming().role == existing().role &&
          (
            existing().role != 'super_admin' ||
            incoming().diff(existing()).affectedKeys().hasOnly(['debtBalance', 'storeDebtBalances', 'totalSpent', 'updatedAt'])
          )
        ) ||
        (
          isOwner(userId) &&
          incoming().id == existing().id &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().cashAssistanceEnabled == existing().cashAssistanceEnabled &&
          incoming().cashAssistanceLimit == existing().cashAssistanceLimit &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'department', 'tableRow', 'tableNumber',
              'avatarInitials', 'avatarUrl', 'updatedAt'
            ]) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['debtBalance', 'storeDebtBalances', 'totalSpent', 'updatedAt']) &&
              incoming().debtBalance >= existing().debtBalance &&
              incoming().totalSpent >= existing().totalSpent
            )
          )
        )
      );

      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // Non-PII Coworker Profiles
    match /coworkerProfiles/{userId} {
      allow get, list: if isVerifiedUser();
      allow create: if isValidId(userId) && isVerifiedUser() && isValidCoworkerProfile(incoming()) && (isOwner(userId) || isAdmin());
      allow update: if isValidId(userId) && isVerifiedUser() && isValidCoworkerProfile(incoming()) && (isOwner(userId) || isAdmin());
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // Platform Subscription Fees & Rules
    match /config/platform {
      allow get: if isVerifiedUser();
      allow create: if isAdmin() && isValidPlatformConfig(incoming());
      allow update: if isSuperAdmin() && isValidPlatformConfig(incoming());
    }

    // Public Storefront Config (Legacy Flagship Sync)
    match /config/store {
      allow get: if true;
      allow create, update: if isAdmin() && isValidStoreConfig(incoming());
    }

    // Confidential Cash Assistance Global Settings
    match /config/cashAssistance {
      allow get: if isCashAssistanceAllowed();
      allow create, update: if isAdmin() && isValidCashAssistanceConfig(incoming());
    }

    // Multi-Store Registry
    match /stores/{storeId} {
      allow get, list: if true;
      allow create: if isValidId(storeId) && isAdmin() && isValidStoreProfile(incoming());
      allow update: if isValidId(storeId) && isVerifiedUser() && isValidStoreProfile(incoming()) && (
        isAdmin() ||
        (
          existing().ownerId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().status == existing().status &&
          incoming().subscriptionStatus == existing().subscriptionStatus &&
          incoming().monthlyFee == existing().monthlyFee &&
          incoming().cashAssistanceActive == existing().cashAssistanceActive &&
          incoming().assignedDeliveryStaffIds == existing().assignedDeliveryStaffIds &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'storeAnnouncement', 'deliveryEnabled',
            'deliveryFee', 'walletAccountName', 'walletAccountNumber',
            'dueDays', 'categories', 'paymentMethods', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(storeId) && isSuperAdmin();
    }

    // Confidential Per-Store Cash Assistance Add-On Subscription
    match /storeCashAssistance/{storeId} {
      allow get: if isValidId(storeId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().storeOwnerId == request.auth.uid && (
          existing().visibleToOwner == true || existing().status in ['pending_approval', 'active', 'suspended']
        ))
      );
      allow list: if isAdmin() || (
        isVerifiedUser() &&
        resource.data.storeOwnerId == request.auth.uid &&
        resource.data.visibleToOwner == true
      );
      allow create: if isValidId(storeId) && isAdmin() && isValidStoreCashAssistance(incoming());
      allow update: if isValidId(storeId) && isVerifiedUser() && isValidStoreCashAssistance(incoming()) && (
        isAdmin() ||
        (
          existing().storeOwnerId == request.auth.uid &&
          existing().visibleToOwner == true &&
          existing().status == 'locked' &&
          incoming().status == 'pending_approval' &&
          incoming().storeId == existing().storeId &&
          incoming().storeName == existing().storeName &&
          incoming().storeOwnerId == existing().storeOwnerId &&
          incoming().visibleToOwner == existing().visibleToOwner &&
          incoming().monthlyFee == existing().monthlyFee &&
          incoming().monthlyInterestRate == existing().monthlyInterestRate &&
          incoming().dueDays == existing().dueDays &&
          incoming().availableTerms == existing().availableTerms &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'requestedAt', 'requestNote', 'updatedAt'])
        )
      );
      allow delete: if isValidId(storeId) && isSuperAdmin();
    }

    // Store Applications
    match /storeApplications/{applicationId} {
      allow get: if isValidId(applicationId) && (
        isAdmin() || (isVerifiedUser() && existing().applicantId == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.applicantId == request.auth.uid);
      allow create: if isValidId(applicationId) && isVerifiedUser() && isValidStoreApplication(incoming()) && (
        isAdmin() || (incoming().applicantId == request.auth.uid && incoming().status == 'pending')
      );
      allow update: if isValidId(applicationId) && isAdmin() && isValidStoreApplication(incoming());
      allow delete: if isValidId(applicationId) && (
        isAdmin() || (isVerifiedUser() && existing().applicantId == request.auth.uid && existing().status == 'pending')
      );
    }

    // Shared Product Catalog Templates
    match /catalogTemplates/{templateId} {
      allow get, list: if isVerifiedUser();
      allow create: if isValidId(templateId) && isVerifiedUser() && isValidCatalogTemplate(incoming()) && (
        isAdmin() || incoming().createdByUserId == request.auth.uid
      );
      allow update: if isValidId(templateId) && isVerifiedUser() && isValidCatalogTemplate(incoming()) && (
        isAdmin() || existing().createdByUserId == request.auth.uid
      );
      allow delete: if isValidId(templateId) && isAdmin();
    }

    // Store-Isolated Customer Credit Balances
    match /storeCustomerCredits/{creditId} {
      allow get: if isValidId(creditId) && (
        isAdmin() ||
        (isVerifiedUser() && (existing().userId == request.auth.uid || existing().storeOwnerId == request.auth.uid))
      );
      allow list: if isAdmin() || (
        isVerifiedUser() && (resource.data.userId == request.auth.uid || resource.data.storeOwnerId == request.auth.uid)
      );
      allow create: if isValidId(creditId) && isVerifiedUser() && isValidStoreCustomerCredit(incoming()) && (
        isAdmin() ||
        incoming().storeOwnerId == request.auth.uid ||
        (incoming().userId == request.auth.uid && incoming().totalPaid == 0)
      );
      allow update: if isValidId(creditId) && isVerifiedUser() && isValidStoreCustomerCredit(incoming()) && (
        isAdmin() ||
        (
          existing().storeOwnerId == request.auth.uid &&
          incoming().storeId == existing().storeId &&
          incoming().storeOwnerId == existing().storeOwnerId &&
          incoming().userId == existing().userId
        ) ||
        (
          existing().userId == request.auth.uid &&
          incoming().storeId == existing().storeId &&
          incoming().storeOwnerId == existing().storeOwnerId &&
          incoming().userId == existing().userId &&
          incoming().balance >= existing().balance &&
          incoming().totalCharged >= existing().totalCharged &&
          incoming().totalPaid == existing().totalPaid
        )
      );
      allow delete: if isValidId(creditId) && isSuperAdmin();
    }

    // Public Storefront Items (Scoped per storeOwnerId for Store Owner edits)
    match /storeItems/{itemId} {
      allow get, list: if true;
      allow create: if isValidId(itemId) && isVerifiedUser() && isValidStoreItem(incoming()) && (
        isAdmin() ||
        ('storeOwnerId' in incoming() && incoming().storeOwnerId == request.auth.uid)
      );
      allow update: if isValidId(itemId) && isVerifiedUser() && isValidStoreItem(incoming()) && (
        isAdmin() ||
        (
          'storeOwnerId' in existing() &&
          existing().storeOwnerId == request.auth.uid &&
          incoming().storeId == existing().storeId &&
          incoming().storeOwnerId == existing().storeOwnerId
        ) ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'soldCount', 'updatedAt']) &&
          incoming().stock <= existing().stock &&
          incoming().soldCount >= existing().soldCount
        )
      );
      allow delete: if isValidId(itemId) && (
        isAdmin() ||
        (isVerifiedUser() && 'storeOwnerId' in existing() && existing().storeOwnerId == request.auth.uid)
      );
    }

    // Store-Scoped Immutable Stock Adjustment & Restock History Logs
    match /stockAdjustments/{adjustmentId} {
      allow get: if isValidId(adjustmentId) && (
        isAdmin() ||
        (isVerifiedUser() && 'storeOwnerId' in existing() && existing().storeOwnerId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isVerifiedUser() && resource.data.storeOwnerId == request.auth.uid
      );
      allow create: if isVerifiedUser() &&
        isValidId(adjustmentId) &&
        isValidStockAdjustment(incoming()) &&
        incoming().id == adjustmentId &&
        incoming().adjustedById == request.auth.uid &&
        exists(/databases/$(database)/documents/storeItems/$(incoming().itemId)) &&
        (
          isAdmin() ||
          ('storeOwnerId' in incoming() && incoming().storeOwnerId == request.auth.uid)
        );
      allow update: if false;
      allow delete: if isValidId(adjustmentId) && isSuperAdmin();
    }

    // Store & Marketplace Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isVerifiedUser() && (
          existing().userId == request.auth.uid ||
          ('sellerId' in existing() && existing().sellerId == request.auth.uid) ||
          ('storeOwnerId' in existing() && existing().storeOwnerId == request.auth.uid) ||
          (isDeliveryStaff() && (
            existing().assignedRunnerId == request.auth.uid ||
            ('assignedDeliveryStaffIds' in existing() && request.auth.uid in existing().assignedDeliveryStaffIds)
          ))
        ))
      );
      allow list: if isAdmin() || (
        isVerifiedUser() && (
          resource.data.userId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          resource.data.storeOwnerId == request.auth.uid ||
          (isDeliveryStaff() && (
            resource.data.assignedRunnerId == request.auth.uid ||
            request.auth.uid in resource.data.assignedDeliveryStaffIds
          ))
        )
      );
      allow create: if isValidId(orderId) && isVerifiedUser() && isValidOrder(incoming()) && (
        isAdmin() ||
        incoming().userId == request.auth.uid ||
        ('storeOwnerId' in incoming() && incoming().storeOwnerId == request.auth.uid)
      );
      allow update: if isValidId(orderId) && isVerifiedUser() && isValidOrder(incoming()) && (
        isAdmin() ||
        (
          'storeOwnerId' in existing() &&
          existing().storeOwnerId == request.auth.uid &&
          incoming().storeId == existing().storeId &&
          incoming().storeOwnerId == existing().storeOwnerId &&
          incoming().userId == existing().userId &&
          incoming().totalAmount == existing().totalAmount &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'deliveryStatus', 'assignedRunnerId', 'assignedRunner',
            'deliveredAt', 'cashCollected', 'debtSettled', 'debtPaidAmount',
            'settledAt', 'logs', 'updatedAt'
          ])
        ) ||
        (
          isDeliveryStaff() &&
          existing().source == 'store' &&
          (
            existing().assignedRunnerId == request.auth.uid ||
            ('assignedDeliveryStaffIds' in existing() && request.auth.uid in existing().assignedDeliveryStaffIds)
          ) &&
          (incoming().status == existing().status || incoming().status in ['Confirmed', 'Completed']) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'deliveryStatus', 'cashCollected', 'deliveredAt',
            'assignedRunnerId', 'assignedRunner', 'logs', 'updatedAt'
          ])
        ) ||
        (
          'sellerId' in existing() &&
          existing().sellerId == request.auth.uid &&
          existing().source == 'marketplace' &&
          incoming().sellerId == existing().sellerId &&
          incoming().userId == existing().userId &&
          incoming().totalAmount == existing().totalAmount &&
          incoming().paymentMethod == existing().paymentMethod &&
          incoming().source == existing().source &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['debtSettled', 'debtPaidAmount', 'settledAt', 'logs', 'updatedAt']) ||
            (
              (
                (existing().status == 'Pending Seller Confirmation' && incoming().status in ['Confirmed', 'Completed', 'Rejected']) ||
                (existing().status == 'Confirmed' && incoming().status == 'Completed' && existing().fulfillment == 'Delivery')
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'deliveryStatus', 'assignedRunnerId', 'assignedRunner',
                'deliveredAt', 'cashCollected', 'debtSettled', 'debtPaidAmount', 'settledAt', 'logs', 'updatedAt'
              ])
            )
          )
        )
      );
      allow delete: if isValidId(orderId) && isSuperAdmin();
    }

    // Payment Proofs
    match /paymentProofs/{proofId} {
      allow get: if isValidId(proofId) && (
        isAdmin() ||
        (isVerifiedUser() && (
          existing().userId == request.auth.uid ||
          ('sellerId' in existing() && existing().sellerId == request.auth.uid) ||
          ('storeOwnerId' in existing() && existing().storeOwnerId == request.auth.uid)
        ))
      );
      allow list: if isAdmin() || (
        isVerifiedUser() && (
          resource.data.userId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          resource.data.storeOwnerId == request.auth.uid
        )
      );
      allow create: if isValidId(proofId) && isVerifiedUser() && isValidPaymentProof(incoming()) && (
        isAdmin() || (incoming().userId == request.auth.uid && incoming().status == 'pending')
      );
      allow update: if isValidId(proofId) && isVerifiedUser() && isValidPaymentProof(incoming()) && (
        isAdmin() ||
        (
          'storeOwnerId' in existing() &&
          existing().storeOwnerId == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status in ['approved', 'rejected'] &&
          incoming().storeId == existing().storeId &&
          incoming().storeOwnerId == existing().storeOwnerId &&
          incoming().userId == existing().userId &&
          incoming().amount == existing().amount &&
          incoming().purpose == existing().purpose &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        ) ||
        (
          'sellerId' in existing() &&
          existing().sellerId == request.auth.uid &&
          existing().purpose == 'Community Seller Settlement' &&
          existing().status == 'pending' &&
          incoming().status in ['approved', 'rejected'] &&
          incoming().sellerId == existing().sellerId &&
          incoming().userId == existing().userId &&
          incoming().amount == existing().amount &&
          incoming().purpose == existing().purpose &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        )
      );
      allow delete: if isValidId(proofId) && isSuperAdmin();
    }

    // Confidential Cash Assistance Loans
    match /loans/{loanId} {
      allow get: if isValidId(loanId) && (
        isAdmin() ||
        (isVerifiedUser() && (
          ('storeOwnerId' in existing() && existing().storeOwnerId == request.auth.uid) ||
          (isCashAssistanceAllowed() && existing().userId == request.auth.uid)
        ))
      );
      allow list: if isAdmin() || (
        isVerifiedUser() && (
          resource.data.userId == request.auth.uid ||
          resource.data.storeOwnerId == request.auth.uid
        )
      );
      allow create: if isValidId(loanId) && isVerifiedUser() && isValidLoan(incoming()) && (
        isAdmin() ||
        (isCashAssistanceAllowed() && incoming().userId == request.auth.uid) ||
        ('storeOwnerId' in incoming() && incoming().storeOwnerId == request.auth.uid)
      );
      allow update: if isValidId(loanId) && isVerifiedUser() && isValidLoan(incoming()) && (
        isAdmin() ||
        (
          'storeOwnerId' in existing() &&
          existing().storeOwnerId == request.auth.uid &&
          incoming().storeOwnerId == existing().storeOwnerId &&
          incoming().userId == existing().userId
        ) ||
        (
          isCashAssistanceAllowed() &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['repayments', 'installments', 'remainingBalance', 'status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(loanId) && isSuperAdmin();
    }

    // Community Suggestions
    match /suggestions/{suggestionId} {
      allow get, list: if isVerifiedUser();
      allow create: if isValidId(suggestionId) && isVerifiedUser() && isValidSuggestion(incoming()) && (
        isAdmin() || incoming().requestedById == request.auth.uid
      );
      allow update: if isValidId(suggestionId) && isVerifiedUser() && isValidSuggestion(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['voterIds', 'voterNames', 'downvoterIds', 'downvoterNames', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'updatedAt'])
      );
      allow delete: if isValidId(suggestionId) && (
        isAdmin() || (isVerifiedUser() && existing().requestedById == request.auth.uid)
      );
    }

    // Coworker For-Sale Marketplace Listings
    match /marketplaceListings/{listingId} {
      allow get: if isValidId(listingId) && (isAdmin() || (isVerifiedUser() && (existing().approvalStatus == 'approved' || existing().sellerId == request.auth.uid)));
      allow list: if isAdmin() || (isVerifiedUser() && (resource.data.approvalStatus == 'approved' || resource.data.sellerId == request.auth.uid));
      allow create: if isValidId(listingId) && isVerifiedUser() && isValidMarketplaceListing(incoming()) && (
        isAdmin() || (incoming().sellerId == request.auth.uid && incoming().approvalStatus == 'pending')
      );
      allow update: if isValidId(listingId) && isVerifiedUser() && isValidMarketplaceListing(incoming()) && (
        isAdmin() ||
        (
          existing().sellerId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().sellerId == existing().sellerId &&
          incoming().approvalStatus == existing().approvalStatus &&
          incoming().commissionType == existing().commissionType &&
          incoming().commissionValue == existing().commissionValue &&
          incoming().soldCount >= existing().soldCount &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'price', 'stock', 'soldCount', 'image',
            'paused', 'allowCash', 'allowDebt', 'pickupNote', 'paymentDetails', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(listingId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().sellerId == request.auth.uid && existing().soldCount == 0)
      );
    }

    // Seller Payout, Reminder & Preference Configurations
    match /sellerConfigs/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isValidSellerConfig(incoming()) && (
        isAdmin() || (isOwner(userId) && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidSellerConfig(incoming()) && (
        isAdmin() || (isOwner(userId) && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // P2P E-Wallet Exchange Posts
    match /ewalletPosts/{postId} {
      allow get, list: if isVerifiedUser();
      allow create: if isValidId(postId) && isVerifiedUser() && isValidEWalletPost(incoming()) && (
        isAdmin() || incoming().authorId == request.auth.uid
      );
      allow update: if isValidId(postId) && isVerifiedUser() && isValidEWalletPost(incoming()) && (
        isAdmin() ||
        existing().authorId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['remainingAmount', 'status', 'completedAtMs', 'fills', 'comments', 'updatedAt'])
      );
      allow delete: if isValidId(postId) && (
        isAdmin() ||
        (
          isVerifiedUser() &&
          existing().status == 'Completed' &&
          'completedAtMs' in existing() &&
          existing().completedAtMs is number &&
          request.time.toMillis() >= existing().completedAtMs + 604800000
        )
      );
    }

    // Chat Threads & Messages Subcollection
    match /chatThreads/{threadId} {
      allow get: if isValidId(threadId) && (
        isSuperAdmin() ||
        (isVerifiedUser() && (
          resource == null ||
          existing().type == 'channel' ||
          ('participantIds' in existing() && request.auth.uid in existing().participantIds)
        ))
      );
      allow list: if isSuperAdmin() || (
        isVerifiedUser() && (resource.data.type == 'channel' || request.auth.uid in resource.data.participantIds)
      );
      allow create: if isValidId(threadId) && isVerifiedUser() && isValidChatThread(incoming()) && (
        (isAdmin() && incoming().type != 'ai') ||
        (incoming().type == 'dm' && 'participantIds' in incoming() && request.auth.uid in incoming().participantIds) ||
        (incoming().type == 'ai' && incoming().id == 'ai-' + request.auth.uid && 'participantIds' in incoming() && incoming().participantIds.size() == 1 && request.auth.uid in incoming().participantIds)
      );
      allow update: if isValidId(threadId) && isVerifiedUser() && isValidChatThread(incoming()) && (
        (isAdmin() && existing().type != 'ai') ||
        (
          (
            existing().type == 'channel' ||
            ('participantIds' in existing() && request.auth.uid in existing().participantIds)
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['unreadCount', 'unreadBy', 'updatedAt'])
        )
      );
      allow delete: if isValidId(threadId) && (
        isSuperAdmin() ||
        (isVerifiedUser() && existing().type in ['dm', 'ai'] && 'participantIds' in existing() && request.auth.uid in existing().participantIds)
      );

      match /messages/{messageId} {
        allow get, list: if isValidId(threadId) && (
          isSuperAdmin() ||
          (isVerifiedUser() && (
            get(/databases/$(database)/documents/chatThreads/$(threadId)).data.type == 'channel' ||
            request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds
          ))
        );
        allow create: if isValidId(threadId) && isValidId(messageId) && isVerifiedUser() && isValidChatMessage(incoming()) && (
          (
            isAdmin() &&
            get(/databases/$(database)/documents/chatThreads/$(threadId)).data.type != 'ai'
          ) ||
          (
            (
              get(/databases/$(database)/documents/chatThreads/$(threadId)).data.type == 'channel' ||
              request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds
            ) &&
            (
              incoming().senderId == request.auth.uid ||
              (incoming().senderId == 'ai' && incoming().senderRole == 'ai')
            )
          )
        );
        allow delete: if isValidId(threadId) && isValidId(messageId) && (
          isSuperAdmin() ||
          (isVerifiedUser() && existing().senderId == request.auth.uid) ||
          (
            isVerifiedUser() &&
            get(/databases/$(database)/documents/chatThreads/$(threadId)).data.type in ['dm', 'ai'] &&
            request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds
          )
        );
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerifiedUser() && (
        existing().targetUserId == request.auth.uid ||
        existing().targetUserId == 'all' ||
        (existing().targetUserId == 'delivery' && isDeliveryStaff()) ||
        (existing().targetUserId == 'admins' && isAdmin()) ||
        (existing().targetUserId == 'super_admin' && isSuperAdmin())
      );
      allow list: if isVerifiedUser() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetUserId == 'all' ||
        (resource.data.targetUserId == 'delivery' && isDeliveryStaff()) ||
        (resource.data.targetUserId == 'admins' && isAdmin()) ||
        (resource.data.targetUserId == 'super_admin' && isSuperAdmin())
      );
      allow create: if isValidId(notificationId) && isVerifiedUser() && isValidNotification(incoming());
      allow update: if isValidId(notificationId) && isVerifiedUser() && isValidNotification(incoming()) && (
        (existing().targetUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        (existing().targetUserId == 'delivery' && isDeliveryStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        (existing().targetUserId == 'admins' && isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        (existing().targetUserId == 'super_admin' && isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        isSuperAdmin()
      );
      allow delete: if isValidId(notificationId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().targetUserId == request.auth.uid) ||
        (isDeliveryStaff() && existing().targetUserId == 'delivery')
      );
    }

    // Internal Companion Apps Directory
    match /internalApps/{appId} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isValidId(appId) && isVerifiedUser() && isValidInternalApp(incoming()) && (
        isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['installed'])
      );
      allow delete: if isValidId(appId) && isAdmin();
    }
  }
}
